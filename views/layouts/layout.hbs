<!DOCTYPE html>
<html>
<head>
    <title>Pogoda</title>
    <link rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
        integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh"
        crossorigin="anonymous">
    <style>
        #box {
            background-color: #fff;
            margin-top: 20px;
            padding: 20px;
            border: 1px solid #ccc;
            border-radius: 20px;
        }
        .main {
            padding-top: 50px;
            font-size: 16px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            grid-template-rows: 1fr;
            grid-column-gap: 0px;
            grid-row-gap: 0px;
            gap: 20px;
        }
        .left{
            grid-area: 1 / 1 / 2 / 2;
            border-right: 1px solid lightslategrey;
        }
        .ico{
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .right{
            grid-area: 1 / 2 / 2 / 3;
        }
        .miasto{
            margin-top: 20px;
            margin-bottom: 10px;
        }
        #country, #city {
            margin-top: 1px;
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .dane p {
            margin: 10px 0;
            font-size: larger;
        }
        .dane{
            font: 1em sans-serif;
            margin-right: 15px;

        }
        .info{
            font-weight: bold;
        }
    </style>
</head>
<body class="bg-info">
    <div id="box" class="col-md-6 offset-md-3" </div>
        {{{body}}}
</body>
</html>