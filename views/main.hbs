<h3>{{viewTitle}}</h3>
    <p>Ta aplikacja pozwala na sprawdzenie aktualnej pogody dla wybranego miasta.</p>
    <p>Wybierz kraj i miasto z listy, aby zobaczyć aktualną temperaturę, wilgotność i inne informacje pogodowe.</p>
    <div class="main">
        <div class="left">
            <div class="ico">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="90" height="90" color="currentColor" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16.5001 22C18.7092 22 20.5001 20.2091 20.5001 18C20.5001 16.9335 20.0827 15.9646 19.4024 15.2475C18.8957 14.7134 18.6424 14.4463 18.5712 14.2679C18.5001 14.0895 18.5001 13.8535 18.5001 13.3815V4C18.5001 2.89543 17.6046 2 16.5001 2C15.3955 2 14.5001 2.89543 14.5001 4V13.3815C14.5001 13.8535 14.5001 14.0895 14.4289 14.2679C14.3577 14.4463 14.1044 14.7134 13.5977 15.2475C12.9174 15.9646 12.5001 16.9335 12.5001 18C12.5001 20.2091 14.2909 22 16.5001 22Z" />
                    <path d="M10.3133 15.8303C8.67792 15.5416 7.36329 14.104 7.20333 12.2607C7.01373 10.076 8.51806 8.14861 10.5634 7.95588C10.883 7.92576 11.197 7.9398 11.5 7.99327M10.2201 4L10.323 5.18677M6.04201 7.57572L5.18359 6.81058M4.611 12.505L3.5 12.6097M6.86776 17.0868L6.15499 18" />
                </svg>

            
            </div>
            <div class="dane">
                <div style="display: flex; justify-content: space-between;">
                    <p>Miasto:</p>
                    <p class="info">
                        <span id="city1">
                            {{#if weather.name}}{{weather.name}}{{else}}--{{/if}}                        
                        </span>
                    </p>
                </div>

                
                <div style="display: flex; justify-content: space-between;">
                    <p>Temperatura:</p>
                    <p class="info">
                        <span id="temperature">
                            {{#if weather.main.temp}}{{weather.main.temp}}{{else}}--{{/if}}
                        </span> °C
                    </p>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <p>Wilgotność:</p>
                    <p class="info">
                        <span id="humidity">
                            {{#if weather.main.humidity}}{{weather.main.humidity}}{{else}}--{{/if}}
                        </span> %
                    </p>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <p>Ciśnienie:</p>
                    <p class="info">
                        <span id="pressure">
                            {{#if weather.main.pressure}}{{weather.main.pressure}}{{else}}--{{/if}}
                        </span> hPa
                    </p>
                </div>
            </div>

        </div>
        <div class="right">
            <form action="/" method="POST" autocomplete="off">

            <div class="kraj">
                <label for="country">Kraj</label><br>
                <select id="country" name="country" required onchange="updateCities()">
                    <option value="" disabled selected>Wybierz kraj</option>
                    <option value="PL">Polska</option>
                    <option value="US">Stany Zjednoczone</option>
                    <option value="GB">Wielka Brytania</option>
                    </select>
            </div>  
            <div class="miasto">
                <label for="city">Miasto</label><br>
                <select id="city" name="city">
                    <option value="">Wybierz miasto</option>
                </select>
            </div>
            <button type="submit" class="btn btn-info">Sprawdź pogodę</button>
            </form>
        </div>
    </div>
    

    <script>
        // Słownik (obiekt) przechowujący predefiniowane listy miast dla poszczególnych krajów.
        // 'name' to nazwa wyświetlana użytkownikowi, a 'value' to nazwa angielska wymagana przez zewnętrzne API pogodowe
        const citiesData = {
            "PL": [
                { name: "Warszawa", value: "Warsaw" },
                { name: "Kraków", value: "Krakow" },
                { name: "Wrocław", value: "Wroclaw" }
            ],
            "US": [
                { name: "Nowy Jork", value: "New York" },
                { name: "Los Angeles", value: "Los Angeles" },
                { name: "Chicago", value: "Chicago" }
            ],
            "GB": [
                { name: "Londyn", value: "London" },
                { name: "Manchester", value: "Manchester" },
                { name: "Edynburg", value: "Edinburgh" }
            ]
        };

    // Funkcja wywoływana automatycznie przy zmianie wybranego kraju w formularzu (zdarzenie onchange)
    function updateCities() {
        // Pobranie referencji do elementów formularza (list rozwijanych)
        const countrySelect = document.getElementById("country");
        const citySelect = document.getElementById("city");
        const selectedCountry = countrySelect.value;
        
        // Resetowanie listy miast do stanu początkowego przy każdej zmianie kraju
        citySelect.innerHTML = '<option value="" disabled selected>Wybierz miasto</option>';

        // Jeśli wybrano prawidłowy kraj i istnieją dla niego dane w słowniku   
        if (selectedCountry && citiesData[selectedCountry]) {
            citySelect.disabled = false;

            // Iteracja po miastach dla wybranego kraju i dynamiczne budowanie opcji wyboru (DOM)
            citiesData[selectedCountry].forEach(city => {
                const option = document.createElement("option");
                option.value = city.value;
                option.textContent = city.name;
                citySelect.appendChild(option);
            });
        } else {
            // Zablokowanie listy miast, jeśli nie wybrano żadnego kraju
            citySelect.disabled = true;
        }
    }
    </script>

   
</form>